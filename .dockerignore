# Build context hygiene: dependencies and build output are produced INSIDE the
# image; local state, ledgers, and secrets must never enter the context.
node_modules
**/node_modules
**/.next
.git
.claude
.env
.env.*
!.env.example
**/.env.local
.factory
**/.factory
test-results
playwright-report
Screenshots
# Root-level docs/media only — scoped so future in-package assets survive.
/*.pdf
/*.docx
/*.png
