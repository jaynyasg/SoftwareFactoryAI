# Software Factory AI — environment template
#
# Copy the lines you need into `packages/web/.env.local` for local development
# (`pnpm dev` loads it), or set them as service env vars on your cloud host
# (Render dashboard / render.yaml `envVars`). Secrets live ONLY in the
# environment: there is deliberately no UI field or ledger record for them (E5).
#
# Everything is optional locally — `pnpm dev` runs with zero configuration.
# Cloud deploys MUST set: SF_RUNTIME, SF_FACTORY_DIR, SF_OPERATOR_TOKEN, and
# (to source runs from GitHub) SF_GIT_CHECKOUT_TOKEN.

# ── Runtime / host ───────────────────────────────────────────────────────────
# local (default) or cloud. Cloud disables local-folder workspaces and requires
# an explicit operator token.
#SF_RUNTIME=local
# Where the append-only JSONL event ledger lives. Cloud: point at the mounted
# persistent disk (render.yaml uses /var/data/.factory).
#SF_FACTORY_DIR=/var/data/.factory
# Public origin of this deployment, used for allowed-origin checks and links.
#SF_PUBLIC_BASE_URL=https://your-factory.onrender.com
# Extra allowed browser origins (comma-separated), if you front the app.
#SF_ALLOWED_ORIGINS=
#SF_HOST=127.0.0.1
#SF_PORT=3000

# ── Auth (operator + CSRF) ──────────────────────────────────────────────────
# REQUIRED in cloud mode. All mutating API/UI commands present this token.
# Render generates one via `generateValue: true`; locally a token file under
# SF_FACTORY_DIR is created automatically.
#SF_OPERATOR_TOKEN=
#SF_CSRF_TOKEN=

# ── Multi-user mode (accounts + per-user credentials) ───────────────────────
# Turn on accounts: invited users sign in, add THEIR OWN Claude/Codex/GitHub
# credentials in the wizard (encrypted at rest), and runs execute on THEIR
# accounts. The shared operator token is refused once this is on, and turning
# the flag off later does NOT downgrade an initialized deployment (fail
# closed). Requires a configured browser origin (SF_PUBLIC_BASE_URL or
# SF_ALLOWED_ORIGINS) for the pre-session CSRF origin check.
#SF_MULTI_USER=1
# REQUIRED with SF_MULTI_USER=1: the vault master key (32 bytes, hex or
# base64url). Keep it ONLY in the platform secret store — never a file under
# the factory dir. Generate:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#SF_MASTER_KEY=
# Consume-once invite that creates the FIRST admin (open /invite/<value>).
# High entropy (16+ chars): openssl rand -base64 24
#SF_BOOTSTRAP_INVITE=
# Break-glass: set to 1 TEMPORARILY so the bootstrap invite can reset the
# admin password; unset it again afterwards.
#SF_BOOTSTRAP_REARM=
# Plain-HTTP LAN opt-out: drops the __Host-/Secure cookie flags so multi-user
# works over http:// on a trusted LAN. Never set this on a public deployment.
#SF_INSECURE_COOKIES=1

# ── Source repos & credentials ──────────────────────────────────────────────
# A run's source can be a LOCAL FOLDER, a GITHUB REPO, either, or neither
# (prompt/PRD-only runs get a fresh generated workspace). GitHub is optional
# locally; in cloud mode it is the only way to bring existing code.
#
# Fine-grained GitHub PAT (contents: read, plus write if the factory should
# push results). Sent to git via an HTTP auth header — never on argv, never
# stored, never shown in the UI.
#SF_GIT_CHECKOUT_TOKEN=github_pat_xxx
# Where cloud/remote checkouts are materialized.
#SF_WORKSPACE_CHECKOUT_ROOT=
# Boundary that local-folder workspaces must live under, and/or an explicit
# comma-separated allowlist of approved folders.
#SF_WORKSPACE_BOUNDARY=
#SF_WORKSPACE_APPROVED_FOLDERS=
# require-clean (default) | allow-dirty for pre-existing local changes.
#SF_WORKSPACE_DIRTY_POLICY=

# ── Worker CLIs (Claude Code / Codex) ───────────────────────────────────────
# The execution adapters shell out to the `claude` / `codex` CLIs and use
# whatever auth those CLIs already have (plan login or API key). The factory
# scrubs nested-session variables but deliberately passes ANTHROPIC_API_KEY,
# CLAUDE_CODE_OAUTH_TOKEN, and OPENAI_API_KEY through, so headless machines
# can authenticate via key/token.
#ANTHROPIC_API_KEY=
# Plan-billed headless Claude auth: mint once with `claude setup-token`.
#CLAUDE_CODE_OAUTH_TOKEN=
# Codex headless auth: the Docker entrypoint turns this into `codex login`.
#OPENAI_API_KEY=
# Claude skill access is FAIL-CLOSED: unset = workers get no Skill tool.
# Comma-separated skill names, or * to allow all installed skills.
#SF_CLAUDE_ALLOWED_SKILLS=
# Skills suggested to workers in the prompt (both families).
#SF_PREFERRED_SKILLS=

# ── Execution queue / daemon ────────────────────────────────────────────────
# 1 = drain queued work on boot WITHOUT an operator click. Leave unset for the
# safe default: work queued before a restart waits for "Resume execution";
# runs you explicitly Start are executed immediately either way.
#SF_EXEC_AUTOSTART=
#SF_EXEC_MAX_ATTEMPTS=3
#SF_EXEC_LEASE_MS=60000
#SF_EXEC_HEARTBEAT_MS=15000
#SF_EXEC_RECONCILE_INTERVAL_MS=30000

# ── Research (optional run modes research-*) ────────────────────────────────
#SF_RESEARCH_ALLOW_NETWORK=
#SF_RESEARCH_DOC_URLS=
#SF_RESEARCH_SEARCH_PROVIDER=
#SF_RESEARCH_SEARCH_API_KEY=
#SF_RESEARCH_MAX_SOURCES=
#SF_RESEARCH_MAX_DURATION_MS=

# ── Deploy targets (for the apps the factory builds) ────────────────────────
# Render is the built-in deploy provider for generated apps.
#SF_RENDER_API_KEY=
#SF_RENDER_SERVICE_ID=
#SF_RENDER_HOSTED_URL=
# GitHub destination the factory publishes generated repos to.
#SF_DEPLOY_GITHUB_OWNER=
#SF_DEPLOY_GITHUB_REPO=
#SF_DEPLOY_ALLOW_TEMP_REPO=
# Local preview overrides.
#SF_PREVIEW_COMMAND=
#SF_PREVIEW_URL=

# ── Planner genome ──────────────────────────────────────────────────────────
#SF_GENOME_DIR=
